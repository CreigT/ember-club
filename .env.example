# Copy these into Vercel → Settings → Environment Variables
# Then redeploy. That is the only owner step besides a domain.

STORE_NAME=Ember Club
STORE_URL=https://your-app.vercel.app
SUPPORT_EMAIL=you@example.com
OWNER_NAME=Legal Owner

# Long random string. Used to sign access cookies. Never put this in the browser.
STORE_SECRET=change-me-to-a-long-random-string

# true = checkout unlocks without charging. Use this until Stripe is ready.
NEXT_PUBLIC_DEMO_MODE=true

# Live Stripe only. Leave blank in demo mode.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
